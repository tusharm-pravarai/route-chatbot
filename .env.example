# Copy this file to .env and fill in your values

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Second local Ollama tag (LiteLLM multi-model / RouteLLM second pair)
# Pull it first: ollama pull llama3
OLLAMA_MODEL_2=llama3

# OpenAI API
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-3.5-turbo

# TypeSafe / Jev (poc/04_jev.ipynb). Leave empty until you have a key.
TYPESAFE_API_KEY=

# Local-only auth for the LiteLLM proxy spun up by poc/06_litellm_autorouter_v2.ipynb
# (needed for POST /auto_router/test_routing). Never leaves localhost — any value works.
LITELLM_MASTER_KEY=sk-litellm-local-change-me

# Knowledge base file
KNOWLEDGE_BASE_PATH=knowledge_base.json
